{$TOWNPET_DOMAIN} {
  root * /srv
  encode gzip
  handle /api/* {
    reverse_proxy backend:8080
  }
  @hashed path /assets/*
  handle @hashed {
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
  }
  handle {
    header Cache-Control "no-cache"
    try_files {path} /index.html
    file_server
  }
}
