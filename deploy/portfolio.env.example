POSTGRES_PASSWORD=replace-with-long-random-value
APP_DB_USER=townpet_app
APP_DB_PASSWORD=replace-with-long-random-value
MIGRATION_DB_USER=townpet_migration
MIGRATION_DB_PASSWORD=replace-with-a-different-long-random-value
TOWNPET_TRUSTED_PROXY_CIDRS=172.16.0.0/12
TOWNPET_DEMO_DATA_ENABLED=false
# Local stack does not include an SMTP server; production enables this after Resend is configured.
TOWNPET_EMAIL_ENABLED=false
MANAGEMENT_HEALTH_MAIL_ENABLED=false
TOWNPET_EMAIL_FROM=no-reply@townpet.example.com
TOWNPET_PUBLIC_BASE_URL=https://townpet.example.com
# Local-only example key: replace it with a unique 32-byte base64 key outside CI/production.
TOWNPET_EMAIL_TOKEN_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=replace-with-smtp-username
SPRING_MAIL_PASSWORD=replace-with-smtp-password
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
TOWNPET_MINIO_ENDPOINT=http://minio:9000
TOWNPET_MINIO_PUBLIC_ENDPOINT=https://media.townpet.example.com
TOWNPET_MINIO_ROOT_ACCESS_KEY=replace-with-minio-root-access-key
TOWNPET_MINIO_ROOT_SECRET_KEY=replace-with-minio-root-secret-key
TOWNPET_MINIO_ACCESS_KEY=replace-with-minio-access-key
TOWNPET_MINIO_SECRET_KEY=replace-with-minio-secret-key
TOWNPET_MINIO_BUCKET=townpet-media
TOWNPET_MINIO_PRESIGN_EXPIRY_SECONDS=900
TOWNPET_DOMAIN=townpet.example.com
TOWNPET_MEDIA_DOMAIN=media.townpet.example.com
HTTP_PORT=80
