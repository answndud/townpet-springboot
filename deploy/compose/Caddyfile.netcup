{$TOWNPET_DOMAIN} {
    reverse_proxy {
        dynamic a townpet-web 80 {
            refresh 5s
            resolvers 127.0.0.11
            versions ipv4
        }
        header_up Host {http.request.host}
    }
}

{$TOWNPET_MEDIA_DOMAIN} {
    reverse_proxy {
        dynamic a townpet-web 80 {
            refresh 5s
            resolvers 127.0.0.11
            versions ipv4
        }
        header_up Host {http.request.host}
    }
}

{$ERP_DOMAIN} {
    reverse_proxy kinderp-caddy:80 {
        header_up Host {http.request.host}
    }
}
