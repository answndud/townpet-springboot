# TLS terminates at the shared edge Caddy. This internal Caddy must stay HTTP-only.
http://{$TOWNPET_DOMAIN} {
	root * /srv
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://{$TOWNPET_MEDIA_DOMAIN}; font-src 'self' data:; connect-src 'self' https://{$TOWNPET_MEDIA_DOMAIN}"
	}
	handle /api/* {
		reverse_proxy backend:8080 {
			header_up Host {http.request.host}
		}
	}
	redir /commercial /marketplace 308
	redir /lost/new /lost-found/new 308
	@private_seo path /admin* /profile* /notifications* /my-posts* /saved* /bookmarks* /login* /password* /verify-email* /onboarding* /corrections/new /adoptions/new /marketplace/new /gatherings/new /care/new /lost-found/new /lost/new /posts/new /guest/posts/new /campaigns/neighborhood-map
	header @private_seo X-Robots-Tag "noindex, nofollow"
	@seo_files path /robots.txt /sitemap.xml
	handle @seo_files {
		header Cache-Control "public, max-age=14400"
		file_server
	}
	@hashed path /assets/*
	handle @hashed {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	@app path / /login /password/reset /verify-email /admin* /onboarding* /boards* /animals* /profile /notifications /privacy /terms /my-posts /saved /bookmarks /search /corrections/new /best /adoptions* /volunteer /hospital-reviews /towns* /lounges/breeds* /guides* /campaigns/neighborhood-map /commercial /marketplace* /gatherings* /care* /members* /users* /posts* /guest/posts/new /lost-found* /lost/new
	handle @app {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
	handle {
		file_server
	}
}

http://{$TOWNPET_MEDIA_DOMAIN} {
	@media_preflight method OPTIONS
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Access-Control-Allow-Origin "https://{$TOWNPET_DOMAIN}"
		Access-Control-Allow-Methods "GET, POST, PUT, OPTIONS"
		Access-Control-Allow-Headers "Content-Type"
		Access-Control-Max-Age "600"
	}
	respond @media_preflight 204
	reverse_proxy minio:9000 {
		header_up Host {http.request.host}
		header_down -Access-Control-Allow-Origin
}
}
