map $uri $townpet_cache_control {
    default "no-cache";
    ~^/assets/ "public, max-age=31536000, immutable";
}

map $request_uri $townpet_robots_tag {
    default "";
    ~^/(admin|profile|notifications|my-posts|saved|bookmarks|login|password|verify-email|onboarding|corrections/new|adoptions/new|marketplace/new|gatherings/new|care/new|lost-found/new|lost/new|posts/new|guest/posts/new|campaigns/neighborhood-map|search|terms|privacy|members)(/|\?|$) "noindex, nofollow";
    ~\? "noindex, nofollow";
}

map $request_uri $townpet_robots_meta {
    default "index,follow";
    ~^/(admin|profile|notifications|my-posts|saved|bookmarks|login|password|verify-email|onboarding|corrections/new|adoptions/new|marketplace/new|gatherings/new|care/new|lost-found/new|lost/new|posts/new|guest/posts/new|campaigns/neighborhood-map|search|terms|privacy|members)(/|\?|$) "noindex,nofollow";
    ~\? "noindex,nofollow";
}

map $request_uri $townpet_canonical_path {
    default "/";
    ~^([^?]*) $1;
}

