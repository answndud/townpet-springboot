map $uri $townpet_cache_control {
    default "no-cache";
    ~^/assets/ "public, max-age=31536000, immutable";
}

map $uri $townpet_robots_tag {
    default "";
    ~^/(admin|profile|notifications|my-posts|saved|bookmarks|login|password|verify-email|onboarding|corrections/new|adoptions/new|marketplace/new|gatherings/new|care/new|lost-found/new|lost/new|posts/new|guest/posts/new|campaigns/neighborhood-map)(/|$) "noindex, nofollow";
}

resolver 127.0.0.11 valid=30s ipv6=off;

server {
    listen 80 default_server;
    server_name _;
    root /srv;

    set $townpet_backend_upstream backend:8080;

    gzip on;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), geolocation=(), microphone=()" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://${TOWNPET_MEDIA_DOMAIN}; font-src 'self' data:; connect-src 'self' https://${TOWNPET_MEDIA_DOMAIN}" always;
    add_header Cache-Control $townpet_cache_control always;
    add_header X-Robots-Tag $townpet_robots_tag always;

    location /api/ {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://$townpet_backend_upstream;
    }

    location = /commercial { return 308 https://$host/marketplace; }
    location ~ ^/users/(.*)$ { return 308 https://$host/members/$1; }
    location = /lost/new { return 308 https://$host/lost-found/new; }
    location = /robots.txt { add_header Cache-Control "public, max-age=14400" always; try_files $uri =404; }
    location = /sitemap.xml { add_header Cache-Control "public, max-age=14400" always; try_files $uri =404; }
    location ^~ /assets/ { try_files $uri =404; }

    location ~ ^/(|login|password/reset|verify-email|admin(?:/|$)|onboarding(?:/|$)|boards(?:/|$)|animals(?:/|$)|profile|notifications|privacy|terms|my-posts|saved|bookmarks|search|corrections/new|best|adoptions(?:/|$)|volunteer|hospital-reviews|towns(?:/|$)|lounges/breeds(?:/|$)|guides(?:/|$)|campaigns/neighborhood-map|commercial|marketplace(?:/|$)|gatherings(?:/|$)|care(?:/|$)|members(?:/|$)|users(?:/|$)|posts(?:/|$)|guest/posts/new|lost-found(?:/|$)|lost/new)(?:/|$) {
        try_files $uri /index.html;
    }

    location / {
        try_files $uri =404;
    }
}

server {
    listen 80;
    server_name ${TOWNPET_MEDIA_DOMAIN};

    set $townpet_minio_upstream minio:9000;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Access-Control-Allow-Origin "https://${TOWNPET_DOMAIN}" always;
    add_header Access-Control-Allow-Methods "GET, POST, PUT, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Content-Type" always;
    add_header Access-Control-Max-Age "600" always;

    location / {
        if ($request_method = OPTIONS) {
            return 204;
        }

        proxy_hide_header Access-Control-Allow-Origin;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://$townpet_minio_upstream;
    }
}
