FROM eclipse-temurin:25.0.5.1_2-jdk@sha256:ce2ef9d2d67a68de5e196d4de9d743327c44a10b57fe02ec39f572c652cacfd3 AS build
WORKDIR /workspace
COPY . .
RUN release_jar="$(find release-artifacts -maxdepth 1 -type f -name '*.jar' ! -name '*-plain.jar' -print -quit 2>/dev/null || true)"; \
    if [ -n "$release_jar" ]; then \
      mkdir -p build/libs && cp "$release_jar" build/libs/townpet-backend.jar; \
    else \
      ./gradlew bootJar --no-daemon; \
    fi

FROM eclipse-temurin:25.0.5.1_2-jre-noble@sha256:2ec98aa522c472deadfd2b7c5b39bca680e33ef522a53a72f10789bdf89a6bb5
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends wget \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 townpet \
    && useradd --system --uid 10001 --gid 10001 --home-dir /app --no-create-home townpet \
    && mkdir -p /app/.townpet \
    && chown -R townpet:townpet /app
COPY --from=build --chown=townpet:townpet /workspace/build/libs/*.jar /app/townpet.jar
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["java", "-XX:+UseContainerSupport", "-XX:-UseBASE64Intrinsics", "-jar", "/app/townpet.jar"]
