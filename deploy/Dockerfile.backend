FROM eclipse-temurin:25-jdk AS build
WORKDIR /workspace
COPY . .
RUN release_jar="$(find release-artifacts -maxdepth 1 -type f -name '*.jar' ! -name '*-plain.jar' -print -quit 2>/dev/null || true)"; \
    if [ -n "$release_jar" ]; then \
      mkdir -p build/libs && cp "$release_jar" build/libs/townpet-backend.jar; \
    else \
      ./gradlew bootJar --no-daemon; \
    fi

FROM eclipse-temurin:25-jre-noble
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends wget \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 townpet \
    && useradd --system --uid 10001 --gid 10001 --home-dir /app --no-create-home townpet \
    && mkdir -p /app/.townpet \
    && chown -R townpet:townpet /app
COPY --from=build --chown=townpet:townpet /workspace/build/libs/*.jar /app/townpet.jar
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["java", "-XX:+UseContainerSupport", "-jar", "/app/townpet.jar"]
